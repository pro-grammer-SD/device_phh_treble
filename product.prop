#PERFORMANCE

# LMK
ro.lmk.kill_timeout_ms=1000
ro.lmk.low=800
ro.lmk.medium=700
ro.lmk.enable_adaptive_lmk=true
ro.lmk.kill_heaviest_task=true
ro.lmk.critical_upgrade=true
ro.config.low_ram=false

#blur active
ro.surface_flinger.supports_background_blur=1
ro.sf.blurs_are_expensive=0
ro.launcher.blur.appLaunch=0

# Enable Material Design 3 Expressive
is_expressive_design_enabled=true

# touch improve
windowsmgr.max_events_per_sec=120
ro.max.fling_velocity=8000
ro.input.highres_time=1
touch.pressure.scale=0.001
ro.surface_flinger.max_frame_buffer_acquired_buffers=2
ro.surface_flinger.max_virtual_display_dimension=1280
ro.surface_flinger.enable_frame_rate_override=false
debug.sf.latch_unsignaled=1
debug.egl.swapinterval=1


ro.bpf.kver_override=5.4.186

# calls
ro.telephony.block_binder_thread_on_incoming_calls=false

